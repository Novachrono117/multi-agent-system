# ==========================================================================
# job-fit-agents - example environment. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored and must never be committed.
#
# Every value below has a working default in src/jobfit/config.py, so the
# test suite and the --offline demo run with NO .env file at all. You only
# need this file to talk to a real model.
# ==========================================================================

# === LLM transport =======================================================
# Which backend the agent loop talks to:
#   fake      - scripted, no network. Used by tests and by `--offline`.
#   ollama    - local model over HTTP. Free. The default for development.
#   anthropic - the Claude API. Costs money; needs JOBFIT_ANTHROPIC_API_KEY.
JOBFIT_TRANSPORT=ollama

# --- ollama (free, local) ------------------------------------------------
# Install from https://ollama.com, then: ollama pull qwen3:8b
# qwen3 supports tool calling and fits in 8 GB of VRAM.
JOBFIT_OLLAMA_BASE_URL=http://127.0.0.1:11434
JOBFIT_OLLAMA_MODEL=qwen3:8b

# --- anthropic (paid) ----------------------------------------------------
# Create a key at https://console.anthropic.com. Leave empty to keep the
# Anthropic transport disabled - nothing else breaks.
JOBFIT_ANTHROPIC_API_KEY=
# Exact model ids, no date suffix. sonnet-5 is ~2.5x cheaper than opus-5.
JOBFIT_ANTHROPIC_MODEL=claude-sonnet-5

# === autonomy limits =====================================================
# Hard ceilings. The graph stops at these instead of spinning; every stop
# is recorded in the run trace with an explicit reason.
JOBFIT_MAX_TOOL_STEPS=8
JOBFIT_MAX_GRAPH_STEPS=12

# === context budget ======================================================
# Job descriptions run long (a real Remotive posting measured 15,796 chars).
# Nothing goes to the model unclipped - it wastes tokens and, on an 8 GB
# GPU, overflows the KV cache.
JOBFIT_MAX_POSTING_CHARS=6000

# === error handling ======================================================
# When true, a programming bug in the LLM path propagates instead of being
# swallowed as "LLM unavailable". Leave true in development.
JOBFIT_STRICT=true

# === job board cache =====================================================
# Remotive's own API notice asks for at most ~4 requests per day, and
# requires attribution with a link back. The cache is how we comply.
JOBFIT_CACHE_DIR=.cache/job_boards
JOBFIT_CACHE_TTL_SECONDS=21600
